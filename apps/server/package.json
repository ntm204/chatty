{
	"name": "@chatty/server",
	"version": "0.2.0-rc.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "tsx watch src/server.ts",
		"build": "tsc -p tsconfig.build.json",
		"start": "node dist/server.js",
		"typecheck": "tsc --noEmit --incremental --tsBuildInfoFile ../../node_modules/.chatty-server-typecheck.tsbuildinfo",
		"test": "vitest run",
		"test:changed": "vitest run --changed --passWithNoTests",
		"db:migrate": "prisma migrate dev",
		"db:generate": "prisma generate",
		"db:seed": "prisma db seed",
		"db:studio": "prisma studio"
	},
	"prisma": {
		"seed": "tsx prisma/seed.ts"
	},
	"dependencies": {
		"@chatty/shared-types": "*",
		"@prisma/client": "^5.22.0",
		"@prometheus-io/client": "^0.16.1",
		"@socket.io/redis-adapter": "^8.3.0",
		"bcrypt": "^6.0.0",
		"compression": "^1.8.1",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.5",
		"dotenv": "^16.4.5",
		"express": "^5.0.1",
		"express-rate-limit": "^8.6.2",
		"ffmpeg-static": "^5.3.0",
		"file-type": "^21.3.4",
		"helmet": "^8.3.0",
		"jsonwebtoken": "^9.0.2",
		"multer": "^2.3.0",
		"nodemailer": "^9.1.1",
		"pino": "^9.5.0",
		"pino-http": "^10.3.0",
		"rate-limit-redis": "^6.0.1",
		"redis": "^6.2.1",
		"sharp": "^0.35.4",
		"socket.io": "^4.8.1",
		"zod": "^3.23.8"
	},
	"devDependencies": {
		"@types/bcrypt": "^6.0.0",
		"@types/compression": "^1.8.1",
		"@types/cookie-parser": "^1.4.10",
		"@types/cors": "^2.8.17",
		"@types/express": "^5.0.0",
		"@types/jsonwebtoken": "^9.0.7",
		"@types/multer": "^2.2.0",
		"@types/node": "^22.9.0",
		"@types/nodemailer": "^8.0.1",
		"prisma": "^5.22.0",
		"socket.io-client": "^4.8.3",
		"tsx": "^4.19.2",
		"typescript": "^5.6.3",
		"vitest": "^4.1.11"
	}
}

// See docs/ARCHITECTURE.md for why the data model looks like this
// (in particular: why there's no separate "DM" vs "group" table).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String             @id @default(cuid())
  email               String             @unique
  // Public, unique identifier used to find someone. Display names are not
  // unique — two people called "Minh" are indistinguishable in search results —
  // and email is deliberately never returned by search, so without a handle
  // there is no safe way to tell two accounts apart.
  // Always stored lowercase: Postgres unique indexes are case-sensitive, so
  // normalising on write is what makes "Minh" and "minh" the same handle.
  handle              String             @unique
  passwordHash        String
  displayName         String
  // When the avatar was last replaced — null means there is no picture.
  //
  // Not a URL. The file lives under one key derived from the user id, and the
  // URL the client gets is built from this timestamp
  // (`/users/:id/avatar?v=<ms>`). Storing the URL instead would mean either
  // rewriting every row to move the files to S3, or keeping the old picture
  // cached in browsers after an upload — the same reason Mattermost stores
  // `last_picture_update` and Rocket.Chat an avatar etag.
  avatarUpdatedAt     DateTime?          @db.Timestamptz(3)
  /// When the password was last replaced, or null if it never has been.
  ///
  /// Read by `requireAuth` and by the socket handshake on every request: a JWT
  /// issued before this moment is refused. Without it, changing or resetting a
  /// password would leave every session opened beforehand working until the
  /// token expired — which is exactly the case a reset is reached for.
  passwordChangedAt   DateTime?          @db.Timestamptz(3)
  /// Whether other people may see how far this user has read.
  ///
  /// Symmetric by design: turning it off also hides everyone else's markers from
  /// them. The server half of that promise is `lastSharedReadMessageId` on the
  /// participant row — while this is false, that column stops advancing, so the
  /// marker never leaves the process rather than being filtered out of a response
  /// somebody could still ask for.
  readReceiptsEnabled Boolean            @default(true)
  lastSeenAt          DateTime?          @db.Timestamptz(3)
  presenceVisibility  PresenceVisibility @default(CONTACTS)
  createdAt           DateTime           @default(now()) @db.Timestamptz(3)

  participants        ConversationParticipant[]
  messages            Message[]
  passwordResetTokens PasswordResetToken[]
  emailChangeTokens   EmailChangeToken[]
  refreshTokens       RefreshToken[]
  stickers            Sticker[]
  hiddenMessages      MessageHiddenFor[]
  reactions           MessageReaction[]
  starredMessages     MessageStar[]
  mentions            MessageMention[]
  pinnedMessages      PinnedMessage[]
  blocksMade          UserBlock[]               @relation("BlocksMade")
  blocksReceived      UserBlock[]               @relation("BlocksReceived")
  restrictionsMade    UserRestriction[]         @relation("RestrictionsMade")
  restrictionsTaken   UserRestriction[]         @relation("RestrictionsReceived")
}

/// One person refusing contact from another. Directed: the row says who did it.
///
/// The *effect* is symmetric even though the row is not — a block stops direct
/// messages in both directions, and hides each from the other's search — which
/// is what every messenger does and what people expect. Storing it as one
/// directed row rather than two is what keeps "who blocked whom" answerable, and
/// only the blocker's own row can be deleted; unblocking is not something the
/// blocked person can do.
///
/// Groups are deliberately untouched. WhatsApp, Messenger and Telegram all leave
/// a blocked person's messages visible in a group both people are in, and the
/// alternative — a placeholder in a shared room — is Discord's, and makes paging
/// and unread counts answer differently for two people looking at one thread.
model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  blocker User @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  // "Does anyone block me?" is asked on every direct send, from the other side
  // of the pair the unique above serves.
  @@index([blockedId, blockerId])
  @@index([blockerId, createdAt, id])
}

/// One person quietly holding another at arm's length.
///
/// Deliberately the same shape as `UserBlock` — directed, one row, unique on the
/// pair — because it answers the same question from the same two sides. What
/// differs is entirely in what the row *means*: a block is symmetric in effect
/// and refuses the write, while a restriction is one-directional and refuses
/// nothing. Messages still arrive; they arrive somewhere quieter.
model UserRestriction {
  id           String   @id @default(cuid())
  restrictorId String
  restrictedId String
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  restrictor User @relation("RestrictionsMade", fields: [restrictorId], references: [id], onDelete: Cascade)
  restricted User @relation("RestrictionsReceived", fields: [restrictedId], references: [id], onDelete: Cascade)

  @@unique([restrictorId, restrictedId])
  /// "Has this person restricted me?" is asked whenever a read receipt or a
  /// presence event is about to cross, which is the opposite side of the pair
  /// from the unique above.
  @@index([restrictedId, restrictorId])
  /// The settings list is a descending keyset over one person's own rows.
  @@index([restrictorId, createdAt, id])
}

enum PresenceVisibility {
  EVERYONE
  CONTACTS
  NOBODY
}

/// A one-time link mailed to an address someone wants to move their account to.
///
/// Separate from `PasswordResetToken` rather than a `kind` column on it, because
/// the two carry different payloads: this one has to remember **which address**
/// was asked for, and a reset token has nothing to remember. Merging them would
/// mean a nullable column that must be non-null for exactly one of the two kinds
/// — the shape of constraint this schema keeps pushing into the database instead.
///
/// The token is stored as a SHA-256, for the reason spelled out on
/// `PasswordResetToken.tokenHash`: a leaked database must not hand over the
/// ability to take an account's address.
model EmailChangeToken {
  id        String    @id @default(cuid())
  userId    String
  /// The address the account moves to when this link is opened.
  ///
  /// Held here rather than written to `User.email` on request, which is the whole
  /// point of the feature: an address nobody has proved they can read must never
  /// become a credential. Uniqueness is **not** enforced on this column — two
  /// people may both ask for an address neither of them owns; only the first to
  /// open their link gets it, and the second fails at redemption against
  /// `User.email`'s own unique index.
  newEmail  String
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  /// Set when the link is opened. Kept rather than deleted, the same way a spent
  /// reset token is: a second click can then be told apart from a made-up token
  /// in the logs, while both answer the caller identically.
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A one-time link mailed to someone who cannot sign in.
///
/// The token itself is never stored — only a SHA-256 of it, the same reasoning
/// that keeps `passwordHash` out of `User.password`: a leaked database must not
/// hand over working credentials. SHA-256 rather than bcrypt because the value
/// being hashed is 32 bytes of `crypto.randomBytes`, and a slow hash defends
/// against guessing that is already impossible.
/// One signed-in session, and the only thing in this app that can be revoked.
///
/// The access token is a JWT and is therefore unrevocable by construction: once
/// signed it is valid until it expires, and nothing the server does can take it
/// back. That was the whole session for a long time, at seven days, which meant
/// "sign out" cleared a browser's `localStorage` and did nothing at all to a
/// token somebody had already copied out of it.
///
/// Splitting the two fixes it without giving up stateless verification on the
/// hot path: the access token stays a JWT and stays short-lived, so the window
/// on a stolen one is minutes rather than a week, and the long-lived half is a
/// row that `revokedAt` can end.
model RefreshToken {
  id String @id @default(cuid())

  userId    String
  /// SHA-256 of the token that was handed out, never the token itself — the
  /// same rule `PasswordResetToken` follows and for the same reason: a leaked
  /// database must not be a drawer full of working sessions.
  ///
  /// SHA-256 rather than bcrypt because what is hashed is 32 random bytes and
  /// already unguessable; a slow hash would defend against nothing and would be
  /// run on every refresh.
  tokenHash String @unique

  expiresAt  DateTime  @db.Timestamptz(3)
  /// Set when this token is spent or the session is ended. Rotation sets it on
  /// the old row as the replacement is created, so a refresh token is
  /// single-use — and a *second* use of an already-spent token is therefore
  /// visible rather than silent.
  revokedAt  DateTime? @db.Timestamptz(3)
  /// Moved on every successful refresh. Not used for anything yet; it is what a
  /// "your sessions" screen would list, and recording it now costs one column.
  lastUsedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Revoking every session for one account — a password change, a reset, a
  /// deleted account — is a query by user, and it happens on the security path
  /// where a sequential scan is the worst place to be.
  @@index([userId])
}

/// One image somebody saved to send again with a single tap.
///
/// Its own table rather than a flag on `Attachment`, because the two have
/// different lifetimes: an attachment belongs to a message and dies with it,
/// while a sticker outlives every message it was ever sent in. Sending one
/// *copies* its bytes into a fresh attachment for exactly that reason —
/// deleting the message must not empty the tray.
model Sticker {
  id     String @id @default(cuid())
  userId String

  /// Stored the same way an attachment is: re-encoded to WebP under this row's
  /// own id. The dimensions are kept for the same reason too — the tray
  /// reserves each tile before the bytes arrive.
  width    Int
  height   Int
  byteSize Int

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The tray is always read as "mine, newest first".
  @@index([userId, createdAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  /// Set the moment the token is redeemed. A used token is kept rather than
  /// deleted so that a second attempt can be told apart from a made-up one in
  /// the logs — both still answer the same thing to the caller.
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Where an outbox message is in its life.
///
/// Three values, and only one of them means "there is still work here": the
/// worker claims PENDING rows and nothing else ever moves back into it. SENT and
/// FAILED are both terminal, and both redact the body — see the model below.
enum OutboxStatus {
  PENDING
  SENT
  FAILED
}

/// An email this app has promised to send but has not sent yet.
///
/// A transactional outbox. The row is written **inside the same transaction as
/// the thing that caused it** — for a password reset, the same transaction that
/// creates the token — so "this link is live" and "we owe this person the link"
/// commit or roll back together. Before this table the send was fired after the
/// commit and forgotten: a crash in that window, or a provider having a bad
/// minute, lost the mail with nothing left to say it had ever been owed.
///
/// It is not a general job queue and should not become one. Everything here is
/// shaped by mail: a recipient, a rendered body, and the fact that sending twice
/// is worse than sending late.
model OutboxMessage {
  id            String       @id @default(cuid())
  status        OutboxStatus @default(PENDING)
  to            String
  subject       String
  /// The rendered message, and **emptied the moment there is nothing left to
  /// send** — on success and on final failure alike.
  ///
  /// This is the one uncomfortable part of an outbox for password reset: the
  /// body contains the live link, so between commit and delivery a working key
  /// to an account sits in a table in plaintext. There is no way around holding
  /// it — the mail cannot be sent without it — so the mitigations are that the
  /// window is one poll interval rather than an hour, that the token's own TTL
  /// bounds the worst case, and that the check constraint below makes the
  /// redaction a property of the data rather than a habit of the worker. Same
  /// argument, and the same shape, as `Message.deletedAt`.
  body          String
  /// How many times delivery has been tried. Attempt zero is a row nobody has
  /// picked up yet, not a row that failed once.
  attempts      Int          @default(0)
  /// The earliest the worker may try again — now for a new row, then pushed out
  /// by exponential backoff after each failure. Also what makes a claim query
  /// cheap: due rows are an index range rather than a scan.
  ///
  /// `dbgenerated`, not `now()`, and the difference is a bug rather than a
  /// preference. Prisma evaluates `@default(now())` in the client, using the
  /// application's clock, while the worker's claim compares this column against
  /// PostgreSQL's `NOW()`. Two clocks. A machine a few milliseconds ahead of the
  /// database writes a row that is not yet due the instant it is created, and on
  /// a real deployment — app and database on different hosts — the skew is not
  /// milliseconds. It showed up here as a test suite that passed four times in
  /// five; it would have shipped as mail that sometimes just sits there.
  ///
  /// Everything that is *compared* against the database clock is therefore
  /// written by the database. `createdAt` and `sentAt` are only ever read by
  /// people, so they stay ordinary.
  nextAttemptAt DateTime     @default(dbgenerated("CURRENT_TIMESTAMP")) @db.Timestamptz(3)
  /// Why the last attempt failed, kept for the person reading the table at 3am.
  /// Never contains the body, so it is safe to log and to keep after redaction.
  lastError     String?
  sentAt        DateTime?    @db.Timestamptz(3)
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)

  // The worker's only query: due PENDING rows, oldest first. Ordering the index
  // this way means it serves both the filter and the sort.
  @@index([status, nextAttemptAt])
}

model Conversation {
  id                 String                   @id @default(cuid())
  // true once a third participant joins; kept explicit rather than derived
  // from participant count so a 1-1 chat that later becomes a group doesn't
  // silently change identity.
  isGroup            Boolean                  @default(false)
  // display name for group chats; null for 1-1 (client derives a name from
  // the other participant)
  name               String?
  /// Who may add people. Any admin may change this; EVERYONE preserves the
  /// original open-invite behaviour, MANAGERS means admins only.
  invitePolicy       ConversationInvitePolicy @default(EVERYONE)
  /// Set only for a group's own photo — mirrors `User.avatarUpdatedAt` exactly,
  /// including the cache-busting scheme. Null in a direct conversation, which
  /// always shows the peer's own avatar instead. Group-only and admin-gated,
  /// same as renaming. See ADR 0022.
  avatarUpdatedAt    DateTime?                @db.Timestamptz(3)
  /// The whole conversation's shared accent, or null for today's fixed
  /// appearance. Cosmetic, so any participant may change it — unlike the
  /// admin-gated settings above. See ADR 0022.
  themeColor         ConversationTheme?
  /// Overrides the app-wide default reaction a double-click on a bubble
  /// leaves (`DEFAULT_REACTION`). Cosmetic, any participant may change it.
  quickReactionEmoji String?
  createdAt          DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                 @updatedAt @db.Timestamptz(3)

  participants   ConversationParticipant[]
  messages       Message[]
  attachments    Attachment[]
  links          MessageLink[]
  pinnedMessages PinnedMessage[]
}

/// Two tiers, symmetric within ADMIN: any admin manages the group, other
/// admins included, and none is more privileged than another. MEMBER acts
/// on themselves and may invite only under open policy. See ADR 0021.
enum ConversationRole {
  ADMIN
  MEMBER
}

enum ConversationInvitePolicy {
  EVERYONE
  MANAGERS
}

/// Restricted to the avatar-tint tokens already in the design palette
/// (@/constants/avatar-colors on the web side) — no new colors introduced.
enum ConversationTheme {
  AZURE
  AMBER
  MOSS
  PLUM
  CLAY
  TEAL
  IRIS
  FERN
}

model ConversationParticipant {
  id                      String           @id @default(cuid())
  conversationId          String
  userId                  String
  /// Every non-empty group keeps at least one ADMIN: the creator starts as
  /// one, and whoever is longest-standing is promoted if the last admin
  /// leaves or is demoted (see `promoteNextAdmin`). Meaningless in a direct
  /// conversation, where both rows stay MEMBER.
  ///
  /// PostgreSQL enforces the cross-row rule Prisma cannot express: a deferred
  /// constraint trigger requires a non-empty group to keep at least one admin
  /// at commit time. See ADR 0021.
  role                    ConversationRole @default(MEMBER)
  joinedAt                DateTime         @default(now()) @db.Timestamptz(3)
  // Newest message this participant has read. Per-participant, so it belongs
  // here and not on Message: "read" is a fact about a person, and a group of
  // ten has ten different answers for the same message.
  //
  // A plain column rather than a relation with a foreign key: SetNull on delete
  // would silently reset someone's marker to "nothing read" the first time a
  // message is deleted, which reads as a whole conversation going unread.
  lastReadMessageId       String?
  /// The same marker, but the half other people are allowed to see.
  ///
  /// Two columns rather than one flag consulted at read time, and the difference
  /// is what "turning read receipts off" actually means here. `lastReadMessageId`
  /// keeps advancing while receipts are off, because the unread badge is the
  /// reader's own business. This one does not — so their position is never
  /// written down anywhere a response could reveal it.
  ///
  /// It is also what stops the toggle from being retroactive. If exposure were
  /// `enabled ? lastReadMessageId : null`, switching receipts back on would
  /// publish everything read while they were off, in one go. Here the shared
  /// marker is still parked where it was when they turned receipts off, and it
  /// catches up only when they read something new — a receipt caused by an
  /// action, which is what a receipt is supposed to be.
  lastSharedReadMessageId String?
  /// Per-participant list organisation. None of these values may be broadcast
  /// with conversation:updated because each viewer sees a different value.
  archivedAt              DateTime?        @db.Timestamptz(3)
  /// A timestamp gives pinned conversations a stable, intentional order.
  pinnedAt                DateTime?        @db.Timestamptz(3)
  /// Null is audible; a far-future timestamp represents "mute forever".
  mutedUntil              DateTime?        @db.Timestamptz(3)
  /// How everyone else in this conversation sees this participant labeled,
  /// here instead — unlike the private fields above, this one *is* broadcast
  /// with conversation:updated: it means the same thing to every viewer.
  /// Settable by any participant, on any row, cosmetic rather than
  /// moderation. See ADR 0022.
  nickname                String?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId, archivedAt])
}

/// Who wrote a message — a person, or the app itself.
///
/// The discriminator for `Message.authorId` being nullable. Reading "authorId
/// is null" as "system" would work today and break the first time a message
/// outlives its author, which is precisely what a deleted account produces.
enum MessageKind {
  USER
  SYSTEM
}

model Message {
  id             String                   @id @default(cuid())
  conversationId String
  /// Who wrote it — null on a SYSTEM message, and null once a USER message
  /// outlives the account that wrote it.
  ///
  /// The phase 7 check constraint used to make those two the same thing
  /// (`USER` implied an author). Deleting an account breaks that: the messages
  /// stay, for exactly the reasons `deletedAt` below is a tombstone rather than a
  /// DELETE, and there is no longer anybody to point at. The constraint now only
  /// holds the other direction — a SYSTEM message has no author — and `kind` is
  /// what tells the two cases apart, which is what it was declared for.
  authorId       String?
  /// Stable id chosen by the sending device. It makes a replay after a lost
  /// response the same write rather than a second message. Null on system and
  /// legacy messages; uniqueness for non-null authors/ids is enforced by the
  /// partial index in the phase 42 migration.
  clientId       String?                  @db.VarChar(64)
  kind           MessageKind              @default(USER)
  // Empty string for a message that is only an image. Nullable would be more
  // truthful, but every read of this column would then need a null branch to
  // save one for the write — and "no caption" and "empty caption" are the same
  // thing to a reader.
  //
  // On a SYSTEM message this holds the sentence itself, already rendered
  // ("An added Binh"). The names in it are a snapshot of who people were when
  // it happened, deliberately — see ADR 0009.
  content        String
  createdAt      DateTime                 @default(now()) @db.Timestamptz(3)
  /// When the author last replaced `content`, or null if they never have.
  ///
  /// A timestamp rather than a boolean because the UI eventually wants to say
  /// *when*, and because "edited" is derivable from it while the reverse is not.
  editedAt       DateTime?                @db.Timestamptz(3)
  /// When the author deleted this message, or null while it stands.
  ///
  /// A tombstone, not a `DELETE`. Two things in this schema point at a message
  /// id without a foreign key to protect them, and both break if the row goes:
  ///
  /// - `ConversationParticipant.lastReadMessageId` is a plain column on purpose
  ///   (see its comment). The unread query LEFT JOINs the marker and reads a
  ///   miss as "nothing read yet", so hard-deleting the newest message would
  ///   relight the badge on the *entire* history for everyone who had read it.
  /// - Message paging passes the oldest loaded id back as a Prisma cursor. A
  ///   cursor row that no longer exists fails the request for the next page.
  ///
  /// `content` is emptied in the same write, and the check constraint below
  /// makes that the database's rule rather than the service's promise — a
  /// deleted message must not still be carrying its text.
  deletedAt      DateTime?                @db.Timestamptz(3)
  /// What search matches against: `to_tsvector('simple', content)`, maintained
  /// by PostgreSQL as a GENERATED column.
  ///
  /// `Unsupported` because Prisma has no tsvector type, and that is fine here —
  /// Prisma leaves such fields out of the generated client entirely, which is
  /// exactly the behaviour a generated column needs. Nothing may write to it,
  /// and nothing can: search reads it through raw SQL.
  ///
  /// Declared at all only so `prisma db pull` and a future `migrate dev` do not
  /// see the column as drift and offer to drop it.
  searchVector   Unsupported("tsvector")?

  /// The message this one answers, or null for an ordinary message.
  ///
  /// A self-relation rather than a copy of the quoted text. A copy would go
  /// stale the moment the original was edited, and would keep showing the words
  /// of a message its author had since deleted — the two cases a quote most
  /// needs to be honest about. The client renders the parent's *current* state,
  /// so a deleted parent quotes as a tombstone.
  ///
  /// The service checks the parent is in the same conversation. Nothing in the
  /// schema can: a foreign key cannot say "and the same conversationId", so that
  /// rule lives in `sendMessage` and is tested there. Without it, a reply could
  /// quote a message out of a conversation the sender is not in.
  replyToId String?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  // SetNull, not Cascade. Cascade would delete every message a departing user
  // ever wrote — gutting other people's conversations, and hard-deleting rows
  // that read markers and paging cursors point at without a foreign key to
  // protect them. See `authorId` above and `deletedAt` below.
  author       User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)
  /// True when this message is a sticker rather than a photograph.
  ///
  /// A column rather than something inferred from "one image and no text": that
  /// shape is also a picture sent without a caption, and the two render nothing
  /// alike — a sticker is drawn bare and large, a photo sits in a bubble.
  isSticker    Boolean      @default(false)
  /// A copy made from another message. The source is deliberately not retained:
  /// forwarded content outlives deletion in the source conversation.
  isForwarded  Boolean      @default(false)

  /// A list since phase 22. It was `Attachment?` only because
  /// `Attachment.messageId` carried a unique — the relation was always
  /// one-to-many underneath, and dropping that unique is what let a message
  /// carry a gallery.
  attachments Attachment[]
  edits       MessageEdit[]
  hiddenFor   MessageHiddenFor[]
  reactions   MessageReaction[]
  links       MessageLink[]
  stars       MessageStar[]
  mentions    MessageMention[]
  pinnedIn    PinnedMessage[]
  // SetNull, not Cascade: a reply outlives the message it answers. Messages are
  // never hard-deleted anyway (see `deletedAt`), so this only fires when a whole
  // conversation goes — and then the reply is going with it regardless.
  replyTo     Message?           @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies     Message[]          @relation("MessageReplies")
  // The GIN index on `searchVector` lives in the phase 12 migration: Prisma
  // cannot express an index method, and an `@@index` here would create a second,
  // useless btree one alongside it.

  @@index([conversationId, createdAt])
  @@index([authorId, clientId])
  @@index([replyToId])
}

/// One person's reaction to one message. At most one.
///
/// The primary key *is* the rule: `(messageId, userId)` and no emoji in it, so
/// the database cannot hold two reactions from the same person on the same
/// message however the service is called. Picking a second emoji is an update,
/// not an insert, which is what Messenger, Instagram and Telegram all do — and
/// with an open emoji set it is the only version that stays bounded.
///
/// It used to include `kind`, back when the set was five names. The count of
/// chips under a message was five at worst then; it is unbounded now.
///
/// The column was a closed `ReactionKind` enum until the phase 29 migration, and
/// the argument that made it one is worth keeping in view: a free string makes
/// "the same reaction" undecidable, because U+2764 and U+2764 U+FE0F are two
/// strings and one heart. That is now settled at the boundary instead of in the
/// type — `toggleReactionSchema` admits a single fully-qualified RGI emoji and
/// nothing else, so exactly one spelling of each reaction can reach this column.
///
/// `VarChar(64)`, not `Text`: the longest RGI sequence in the standard is a
/// four-person family with skin tones, which is 10 code points and around 35
/// bytes. 64 is that with room, and it is a second, cruder guard on a column
/// whose whole risk is that it accepts a string.
model MessageReaction {
  messageId String
  userId    String
  emoji     String   @db.VarChar(64)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  // Cascade, unlike everything else pointing at a User here. A reaction carries
  // no history worth keeping without the person who left it: nothing points at
  // it, and the count simply drops by one. Messages get SetNull because they are
  // somebody's words and other people's read markers point at them; a reaction
  // is neither.
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([messageId])
}

model MessageEdit {
  id        String   @id @default(cuid())
  messageId String
  content   String
  editedAt  DateTime @default(now()) @db.Timestamptz(3)

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId, editedAt])
}

model MessageHiddenFor {
  messageId String
  userId    String
  hiddenAt  DateTime @default(now()) @db.Timestamptz(3)

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([userId])
}

enum AttachmentKind {
  IMAGE
  FILE
  AUDIO
}

/// A file carried by a message. Images and voice notes are re-encoded by this
/// server; ordinary files keep their bytes and are served only as downloads.
model Attachment {
  id             String         @id @default(cuid())
  messageId      String
  /// Denormalised from Message so the vault can page with one index scan. A
  /// message never changes conversation and both rows are written together.
  conversationId String
  kind           AttachmentKind @default(IMAGE)
  /// Decided from the bytes by the server, never trusted from the upload header.
  mediaType      String
  /// Display/download name only. It is never used to construct a storage path.
  fileName       String?
  /// Where this attachment sits among the message's others, from 0.
  ///
  /// Stored rather than derived from `createdAt`, because the images of one
  /// message are written inside a single transaction and share a timestamp to
  /// the millisecond — ordering by it would shuffle a gallery between reads.
  /// The order is the one the sender picked in the composer, and a gallery that
  /// reorders itself on reload is a gallery nobody can point at.
  position       Int
  // Null for non-images. Images keep them so the thread reserves space before
  // bytes arrive instead of jumping during decode.
  width          Int?
  height         Int?
  byteSize       Int
  /// Null unless AUDIO. The waveform is always 64 RMS buckets in the range 0-100.
  durationMs     Int?
  waveform       Int[]          @default([])
  /// Null on legacy images; clients fall back to the full-size URL.
  hasThumbnail   Boolean        @default(false)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)

  message      Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  /// Replaces the unique on `messageId` alone, which is what limited a message
  /// to one picture. Kept unique on the pair rather than dropped entirely: two
  /// images claiming slot 0 is an ordering the database should refuse, not one
  /// the reader discovers.
  @@unique([messageId, position])
  @@index([messageId])
  @@index([conversationId, kind, createdAt])
}

/// A URL extracted when a message is written. It is indexed rather than found
/// by scanning message text, and is never fetched by the server.
model MessageLink {
  id             String   @id @default(cuid())
  messageId      String
  conversationId String
  url            String
  position       Int
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  message      Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([messageId, position])
  @@index([conversationId, createdAt])
}

/// A private bookmark. It never rides on broadcast MessageDTO payloads.
model MessageStar {
  messageId String
  userId    String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([userId, createdAt])
}

/// A participant explicitly named by a group message. Stored by id so renames
/// do not silently break notification semantics.
model MessageMention {
  messageId String
  userId    String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([userId, createdAt])
}

/// One of at most three messages participants have pinned in a conversation.
model PinnedMessage {
  conversationId String
  messageId      String
  pinnedById     String
  pinnedAt       DateTime @default(now()) @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  pinnedBy     User         @relation(fields: [pinnedById], references: [id], onDelete: Cascade)

  @@id([conversationId, messageId])
  @@index([conversationId, pinnedAt])
}

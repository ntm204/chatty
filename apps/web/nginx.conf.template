# Rendered by nginx's own entrypoint (`/docker-entrypoint.d/20-envsubst-on-templates.sh`)
# before the server starts, which is why this is a template rather than a plain
# conf: the Content-Security-Policy below has to name the API's origin, and that
# origin is not known when the image is built for anyone but the default.
#
# `envsubst` only replaces variables that exist in the environment, so nginx's
# own `$uri` and `$csp` survive it untouched.

server {
	listen 8080;
	root /usr/share/nginx/html;

	# What this app is allowed to load, and from where. The API's headers were set
	# in phase 11; this is the other half, and it is the half that matters for a
	# chat app — every message in it is a string a stranger typed.
	#
	# React escapes what it renders, so this is defence in depth rather than the
	# only thing standing between a message and script execution. That is the
	# point: the day something reaches `dangerouslySetInnerHTML`, or a dependency
	# does it on this app's behalf, the policy is what is left.
	#
	# Directive by directive, because each one is a decision:
	#
	# - `script-src 'self'` with no `'unsafe-inline'`. Vite's production build is
	#   fingerprinted module files and nothing inline, so this costs nothing here —
	#   and `'unsafe-inline'` would make the rest of the policy decorative.
	# - `style-src 'self'`. Tailwind compiles to one static stylesheet, and a grep
	#   of apps/web/src finds no `style={{ }}` anywhere. Adding a first one will
	#   break under this policy, which is the correct outcome rather than a reason
	#   to relax it: `cn()` and a class are how this codebase styles things.
	# - `img-src` includes the API origin because avatars and attachments are
	#   served from it into an `<img>` on this origin — the same cross-origin fact
	#   that made phase 11 set `Cross-Origin-Resource-Policy: cross-origin` there.
	#   `data:` is for anything a library inlines. `blob:` permits local image
	#   and voice previews; script-src remains restricted to self.
	# - `connect-src` needs the WebSocket origin *as well as* the HTTP one. A CSP
	#   source expression matches by scheme, and `ws:` is not `http:` — so a policy
	#   naming only the API URL would let every fetch through and silently kill the
	#   socket, which is the entire product. `API_WS_ORIGIN` is derived from
	#   `API_ORIGIN` by `10-derive-ws-origin.envsh`, so there is one value to set.
	# - `frame-ancestors 'none'` is clickjacking cover, and it is the modern
	#   replacement for `X-Frame-Options` rather than a duplicate of it.
	# - `object-src 'none'` and `base-uri 'self'` close two injection routes that
	#   `default-src` does not: plugin content, and rewriting where every relative
	#   URL on the page resolves to.
	set $csp "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob: ${API_ORIGIN}; media-src 'self' blob: ${API_ORIGIN}; font-src 'self' data:; connect-src 'self' ${API_ORIGIN} ${API_WS_ORIGIN}; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'";

	# Held in a variable and re-added per location because `add_header` does not
	# merge: a location that sets any header of its own discards every one
	# inherited from the server block. Both locations below set a `Cache-Control`,
	# so both would silently lose the policy — a CSP that switches itself off on
	# exactly the files it governs is worse than none. One string, three uses.
	add_header Content-Security-Policy $csp always;

	# Not covered by the CSP, and worth having anyway: stop the browser guessing a
	# response is something other than what it was served as, and stop the full
	# URL — which carries a signed attachment token in the query string — from
	# reaching another origin in a `Referer`.
	add_header X-Content-Type-Options "nosniff" always;
	add_header Referrer-Policy "strict-origin-when-cross-origin" always;

	# The app is a single-page app with client-side routing: /profile and /chat
	# are real URLs to the user and not files on disk, so anything that is not a
	# real file has to fall through to index.html or a reload 404s.
	location / {
		try_files $uri $uri/ /index.html;
	}

	# Vite fingerprints these filenames, so a changed file is a changed URL and
	# nothing cached under the old one is ever wrong.
	location /assets/ {
		expires 1y;
		add_header Cache-Control "public, immutable";
		add_header Content-Security-Policy $csp always;
		add_header X-Content-Type-Options "nosniff" always;
		add_header Referrer-Policy "strict-origin-when-cross-origin" always;
	}

	# index.html must NOT be cached: it is the one file whose name never changes
	# and which points at all the fingerprinted ones. A stale copy pins a browser
	# to a deployment that no longer exists.
	location = /index.html {
		add_header Cache-Control "no-cache";
		add_header Content-Security-Policy $csp always;
		add_header X-Content-Type-Options "nosniff" always;
		add_header Referrer-Policy "strict-origin-when-cross-origin" always;
	}

	gzip on;
	gzip_types text/css application/javascript application/json image/svg+xml;
}

{
	"name": "@chatty/web",
	"version": "0.2.0-rc.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"typecheck": "tsc --noEmit --incremental --tsBuildInfoFile ../../node_modules/.chatty-web-typecheck.tsbuildinfo",
		"test": "vitest run",
		"test:changed": "vitest run --changed --passWithNoTests",
		"preview": "vite preview",
		"predev": "node scripts/prepare-fonts.mjs",
		"prebuild": "node scripts/prepare-fonts.mjs"
	},
	"dependencies": {
		"@chatty/shared-types": "*",
		"@fontsource/geist": "^5.3.0",
		"@fontsource/geist-mono": "^5.3.0",
		"@fontsource/instrument-serif": "^5.3.0",
		"clsx": "^2.1.1",
		"lucide-react": "^1.33.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-router-dom": "^7.18.3",
		"socket.io-client": "^4.8.1",
		"tailwind-merge": "^3.6.0",
		"zustand": "^5.0.1"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.6",
		"@types/react": "^18.3.12",
		"@types/react-dom": "^18.3.1",
		"@vitejs/plugin-react": "^6.1.1",
		"fake-indexeddb": "^6.2.5",
		"jsdom": "^30.0.1",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.6.3",
		"vite": "^8.2.2",
		"vitest": "^4.1.11"
	}
}

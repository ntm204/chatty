node_modules/
dist/
build/
# `tsc -b` writes this next to tsconfig.json to cache what it already compiled.
*.tsbuildinfo
# Local state, not source: the Postgres volume and uploaded avatars both live here.
.data/
.env
.env.local
*.log
.DS_Store
coverage/
# Playwright writes these on every run; traces in particular are large.
test-results/
playwright-report/
.turbo/
# Local CodeGraph index; contributors can regenerate it from the working tree.
.codegraph/
# Editor state is local. Repository-wide tooling belongs in committed config
# files rather than settings that only one IDE reads.
.vscode/

# Fontshare fonts are obtained by each checkout, never redistributed as source.
apps/web/src/assets/fonts/*.woff2

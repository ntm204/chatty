{
	"name": "chatty",
	"private": true,
	"version": "0.2.0",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"engines": {
		"node": ">=22.22.2"
	},
	"scripts": {
		"audit:rules": "node scripts/run-audit.mjs",
		"backup:prod": "scripts/backup-production.sh",
		"build": "npm run build --workspaces --if-present",
		"db:down": "docker compose down",
		"db:up": "docker compose up -d postgres",
		"dev:server": "npm run dev --workspace apps/server",
		"dev:web": "npm run dev --workspace apps/web",
		"e2e:install": "playwright install chromium",
		"format": "prettier --write .",
		"format:check": "prettier --check . --end-of-line auto --cache --cache-location=node_modules/.prettier-cache",
		"lint": "eslint . --cache --cache-location node_modules/.eslintcache",
		"restore:prod": "scripts/restore-production.sh",
		"seed:demo": "node scripts/seed-demo.mjs",
		"test": "node scripts/run-check.mjs test",
		"test:changed": "node scripts/run-check.mjs test:changed",
		"test:tooling": "node --test scripts/tests/*.test.mjs",
		"test:e2e": "node scripts/run-check.mjs test:e2e",
		"test:e2e:smoke": "node scripts/run-check.mjs test:e2e:smoke",
		"typecheck": "npm run typecheck --workspaces --if-present && npm run typecheck:e2e",
		"typecheck:e2e": "tsc -p tsconfig.e2e.json --incremental --tsBuildInfoFile node_modules/.chatty-e2e-typecheck.tsbuildinfo",
		"verify": "node scripts/run-check.mjs verify",
		"verify:full": "node scripts/run-check.mjs verify:full",
		"verify:audit": "node scripts/run-audit.mjs --gate",
		"version:check": "node scripts/check-version.mjs",
		"test:e2e:built": "node scripts/run-check.mjs test:e2e:built"
	},
	"devDependencies": {
		"@eslint/js": "^9.15.0",
		"@playwright/test": "^1.62.1",
		"eslint": "^9.15.0",
		"eslint-config-prettier": "^9.1.0",
		"prettier": "^3.3.3",
		"typescript": "^5.6.3",
		"typescript-eslint": "^8.14.0"
	},
	"allowScripts": {
		"@prisma/client@5.22.0": true,
		"@prisma/engines@5.22.0": true,
		"bcrypt@6.0.0": true,
		"esbuild@0.28.2": true,
		"ffmpeg-static@5.3.0": true,
		"prisma@5.22.0": true
	}
}
